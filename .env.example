# Copy to .env and fill in your values: `cp .env.example .env`
# `source activate` loads this into the environment (AWS_PROFILE/REGION + TF_VAR_*).
# .env itself is gitignored — never commit real values.

# AWS credentials: set a named profile, or leave blank to use the default
# credential chain (env vars, SSO, instance role, etc.).
AWS_PROFILE=
AWS_REGION=us-east-1

# Naming (null-label): resources are named <namespace>-<name>-<attributes>,
# e.g. the artifacts bucket becomes "<namespace>-<name>-artifacts".
NAMESPACE=example
NAME=microvm-dev

# Terraform variables (derived from the above — usually leave as-is).
TF_VAR_name=${NAME}
TF_VAR_namespace=${NAMESPACE}
TF_VAR_region=${AWS_REGION}
TF_VAR_profile=${AWS_PROFILE}

# Optional: pin a specific terraform binary. Leave both unset to use the
# `terraform` on your PATH.
# TERRAFORM_VERSION="v1.17.1"
# TERRAFORM_BIN="/usr/local/bin/terraform-$TERRAFORM_VERSION"
