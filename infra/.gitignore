# Terraform working dir and plugins
.terraform/
.terraform.tfstate.lock.info

# State files (never commit — may contain secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets; ignore by default.
# Commit an example instead (e.g. terraform.tfvars.example).
*.tfvars
*.tfvars.json
!*.tfvars.example

# Generated backend config (written by tfstate-backend module)
backend.tf

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / credentials
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally committed so provider
# versions are pinned and reproducible across the team and CI.
